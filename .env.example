# Core
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4173
NODE_ENV=development
SEARYA_DB_PATH=./data/searya.sqlite

# Development checkout immediately grants test credits. Use polar in production.
PAYMENT_MODE=demo
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_BUYER_CONNECTIONS_10=
POLAR_PRODUCT_SELLER_LISTINGS_3=
POLAR_PRODUCT_SELLER_VIP_10=

# Transactional email (optional until configured)
RESEND_API_KEY=
EMAIL_FROM=Searya <hello@example.com>

# Social sign-in. Provider buttons activate only when every required key exists.
# Google redirect URI: https://searya.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Search discovery. The default public IndexNow key works out of the box.
# Override only when rotating the key; the app serves /{INDEXNOW_KEY}.txt automatically.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
PUBLIC_ORIGIN=https://searya.com

# Google supports general marketplace/blog discovery through Search Console sitemaps.
# Add the service-account email as an owner/user of the matching Search Console property.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:searya.com
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://searya.com/sitemap.xml
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=


# Set these before the first production start to create the initial administrator.
SEARYA_ADMIN_EMAIL=
SEARYA_ADMIN_PASSWORD=
SEARYA_ADMIN_NAME=Searya Admin
