# Core
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4173
NODE_ENV=development
SEARYA_DB_PATH=./data/searya.sqlite

# Development checkout immediately grants test credits. Use stripe in production.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (optional until configured)
RESEND_API_KEY=
EMAIL_FROM=Searya <hello@example.com>

# Set these before the first production start to create the initial administrator.
SEARYA_ADMIN_EMAIL=
SEARYA_ADMIN_PASSWORD=
SEARYA_ADMIN_NAME=Searya Admin
